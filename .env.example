FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your-secret-key-here

# --- Opsi A: Database lokal (SQLite) ---
# Biarkan baris DATABASE_URL di bawah dikomentari/dihapus untuk pakai SQLite lokal secara default.
# DATABASE_URL=sqlite:///database/belajaryuk.db

# --- Opsi B: Database online (Filess.io - MySQL) ---
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
# Ambil nilainya dari tab "Connection Information" di dashboard Filess.io.
DATABASE_URL=mysql+pymysql://user:password@host:port/database_name
